{
  "uid": "kb-pipeline-overview",
  "title": "KB Pipeline Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Documents (not deleted)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "kb-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) FROM raw_documents WHERE status <> 'deleted'"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Chunks",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "kb-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) FROM processed_chunks"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Un-embedded chunks",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "kb-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) FROM processed_chunks WHERE embedding_id IS NULL"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Failed documents",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "postgres",
        "uid": "kb-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) FROM raw_documents WHERE status = 'failed'"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Last crawl per source",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "kb-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DISTINCT ON (s.code) s.code AS source, cj.status, cj.started_at, cj.completed_at, cj.pages_found, cj.pages_new, cj.pages_changed, cj.pages_deleted, cj.pages_errored FROM crawl_jobs cj JOIN sources s ON cj.source_id = s.id ORDER BY s.code, cj.started_at DESC"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Documents by source and status",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "kb-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.code AS source, rd.status, COUNT(*) AS documents FROM raw_documents rd JOIN sources s ON rd.source_id = s.id GROUP BY 1,2 ORDER BY 1,2"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Chunks, tokens and embedding coverage",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "kb-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT s.code AS source, COUNT(pc.id) AS chunks, COUNT(pc.embedding_id) AS embedded, COALESCE(SUM(pc.token_count),0) AS tokens FROM processed_chunks pc JOIN raw_documents rd ON pc.document_id = rd.id JOIN sources s ON rd.source_id = s.id WHERE rd.status <> 'deleted' GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent task executions",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "kb-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT created_at, task_name, source_code, status, completed_at, error_message FROM task_executions ORDER BY created_at DESC LIMIT 20"
        }
      ]
    }
  ]
}