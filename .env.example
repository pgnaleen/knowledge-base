# Database (use 'postgres' as host when running inside Docker)
DATABASE_URL=postgresql://kb_user:kb_pass@localhost:5432/kb_pipeline_db

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=sg-property-kb

# OpenRouter (primary embedding provider)
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (fallback embedding provider)
OPENAI_API_KEY=sk-your-key-here

# Pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=kb-pipeline
PINECONE_ENVIRONMENT=us-east-1

# Crawler Settings
CRAWL_DELAY=2.0
CRAWL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
