# Database
DATABASE_URL=postgresql://kb_user:kb_pass@localhost:5433/knowledge_base

# Redis
REDIS_URL=redis://localhost:6379/0

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=knowledge-base
S3_REGION=us-east-1

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=knowledge-base
PINECONE_ENVIRONMENT=us-east-1

# Crawler Settings
CRAWL_DELAY=2.0
CRAWL_USER_AGENT=KnowledgeBaseBot/1.0 (+https://github.com/your-org/knowledge-base)
CRAWL_RESPECT_ROBOTS_TXT=true
CRAWL_MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO
