# OpenAI Configuration
OPENAI_API_KEY=                       # Get from https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4o                   # or gpt-4o-mini for lower cost

# KB-Pipeline Configuration
KB_PIPELINE_URL=http://localhost:8000 # External retrieval service

# CORS Configuration
CORS_ORIGINS=http://localhost:5173    # Comma-separated for production: https://app.com,https://api.app.com

# Optional: Logging
LOG_LEVEL=INFO
