LLM_PROVIDER=openrouter

# OpenRouter (current)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI (kept for future switching)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# KB-Pipeline
KB_PIPELINE_URL=http://localhost:8000

# Frontend
CORS_ORIGINS=http://localhost:5173

# WhatsApp
WHATSAPP_TOKEN=your_long_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_WABA_ID=your_waba_id_here
WHATSAPP_VERIFY_TOKEN=your_secret_verify_token_here
WHATSAPP_APP_SECRET=your_app_secret_here

# LangSmith Observability
# Sign up at https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT=sg-property-advisor
