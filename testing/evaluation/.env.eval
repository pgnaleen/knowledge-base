# Eval-only environment — points to ISOLATED test databases.
# NEVER use production PINECONE_INDEX or DATABASE_URL here.

# Isolated PostgreSQL database for eval (create with: psql -c "CREATE DATABASE kb_pipeline_eval;")
DATABASE_URL=postgresql://kb_user:kb_pass@localhost:5432/kb_pipeline_eval

# Isolated Pinecone index for eval (create manually in Pinecone dashboard: dimension=3072, metric=cosine)
PINECONE_INDEX=kb-pipeline-eval
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1

# OpenAI — used by DeepEval's LLM judge (Faithfulness, AnswerRelevancy, ContextualPrecision, ContextualRecall)
OPENAI_API_KEY=your_openai_api_key_here

# Eval KB-Pipeline API (run on port 8003 with the above env vars)
KB_PIPELINE_URL=http://localhost:8003

# Backend under test (same backend binary, but MCP_SERVER_URL must point to eval MCP server)
BACKEND_URL=http://localhost:8001
